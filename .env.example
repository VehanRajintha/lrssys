# Gemini Vision API Keys (Dedicated 3-Stream Concurrency)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_BACKUP_API_KEY=your_backup_gemini_api_key_here
GEMINI_API_KEY_3=your_third_gemini_api_key_here

# Storage Provider (Optional: 'local' forces 100% VPS SSD disk storage with 0 Supabase usage)
# On a VPS, set this to 'local' for lightning-fast speeds and zero cloud storage costs:
STORAGE_PROVIDER=local

# Supabase Configuration (Optional on VPS - only needed if you want database sync or cloud backup)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
